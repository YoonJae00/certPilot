# CertPilot 데모 배포 환경 변수 예시.
# 이 파일을 `.env.prod` 로 복사해서 값을 채운다. **`.env.prod` 는 절대 커밋하지 않는다**
# (리포 루트 .gitignore 가 `.env.*` 를 막고 있다).
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# `deploy.sh` 는 권한이 600/400 이 아니거나 `CHANGE_ME` 가 남아 있으면 배포를 거부한다.
# 그러니 **쓰지 않는 항목은 지우거나 빈 값으로** 둔다(CHANGE_ME 를 남겨 두지 않는다).
#
# 배포 경로별 요약 (자세한 절차는 README-deploy.md)
#   A. 오라클 클라우드 무료 VM 1대  → CERTPILOT_PROFILES=local-db,local-storage
#   B. AWS EC2 + RDS + S3          → 프로파일 없이 관리형 엔드포인트를 채운다

# ==========================================================================
# 프로파일 — VM 안에서 무엇을 컨테이너로 대신 띄울지
# ==========================================================================
# local-db       : postgres 컨테이너를 켠다(관리형 DB 없음)
# local-storage  : MinIO 컨테이너를 켠다(S3·Object Storage 없음)
# 비워 두면 둘 다 끈다(관리형 서비스를 쓴다는 뜻).
# deploy.sh 가 이 값을 읽어 --profile 로 넘긴다. CLI 플래그로도 줄 수 있다.
CERTPILOT_PROFILES=local-db,local-storage

# ==========================================================================
# 데이터베이스 (PostgreSQL 16 + pgvector 확장)
# ==========================================================================
# local-db 프로파일: 호스트를 컨테이너 이름 `postgres` 로 둔다(아래가 그 형태다).
DATABASE_URL=postgresql+psycopg://certpilot:CHANGE_ME@postgres:5432/certpilot
# 관리형 RDS 를 쓸 때는 엔드포인트로 바꾼다:
# DATABASE_URL=postgresql+psycopg://certpilot:CHANGE_ME@certpilot-db.xxxx.ap-northeast-2.rds.amazonaws.com:5432/certpilot

# local-db 프로파일을 켤 때만 쓰인다. 위 DATABASE_URL 의 값과 반드시 일치시킨다.
POSTGRES_USER=certpilot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=certpilot

# --- Redis (Celery 브로커 겸 결과 백엔드) ---
# compose 안의 redis 컨테이너를 가리킨다. 컨테이너 이름이 곧 호스트명이다.
REDIS_URL=redis://redis:6379/0

# ==========================================================================
# 오브젝트 스토리지 (원문 문서·증적 스냅샷·산출물)
# ==========================================================================
# 셋 중 하나를 고른다.
#
# (a) local-storage 프로파일 — 이 VM 의 MinIO. 아래 3줄이 그 형태다.
#     S3_ACCESS_KEY/S3_SECRET_KEY 가 그대로 MinIO 루트 자격증명이 된다
#     (사용자 3자 이상, 비밀번호 8자 이상). 컨테이너 볼륨에만 남으므로
#     VM 을 지우면 원문도 같이 사라진다 — 데모용으로만 쓴다.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=certpilot
S3_ACCESS_KEY=certpilot
S3_SECRET_KEY=CHANGE_ME
# SigV4 서명 리전. MinIO 는 아무 값이나 통과시킨다.
S3_REGION=us-east-1
#
# (b) 오라클 Object Storage (S3 호환 API) — 무료 VM 을 쓰면서 데이터는 남기고 싶을 때.
#     콘솔 > 아이덴티티 > 내 사용자 > 고객 비밀 키(Customer Secret Key)로 키를 만든다.
#     네임스페이스: `oci os ns get`
#     S3_ENDPOINT=https://<네임스페이스>.compat.objectstorage.ap-chuncheon-1.oraclecloud.com
#     S3_BUCKET=certpilot-demo
#     S3_ACCESS_KEY=<고객 비밀 키의 액세스 키>
#     S3_SECRET_KEY=<고객 비밀 키의 시크릿>
#     S3_REGION=ap-chuncheon-1        # 버킷 리전과 반드시 일치(불일치 시 서명 오류)
#
# (c) AWS S3
#     버킷은 퍼블릭 액세스 전면 차단 + 기본 암호화(SSE-S3 이상) + 버전 관리를 켠다.
#     S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
#     S3_BUCKET=certpilot-demo-<접미사>
#     S3_ACCESS_KEY=<이 버킷에만 권한을 준 전용 IAM 사용자>
#     S3_SECRET_KEY=<시크릿>
#     S3_REGION=ap-northeast-2

# ==========================================================================
# LLM (모의심사 판정)
# ==========================================================================
# auto(키 있는 것 자동: openai → anthropic → fake) | openai | anthropic | fake
# 키가 하나도 없으면 결정적 Fake 프로바이더로 떨어진다(부팅은 되지만 판정 품질은
# 데모용이 아니다). 발표 전에 반드시 키를 넣고 한 번 돌려 본다.
LLM_PROVIDER=auto
OPENAI_API_KEY=
# 판정 모델 (2026-08 기준: gpt-5.6 균형 / gpt-5.6-luna 저가 / gpt-5.5 고성능)
OPENAI_MODEL=gpt-5.6
# 옵션 — 대체 프로바이더. 쓰지 않으면 빈 값으로 둔다.
ANTHROPIC_API_KEY=

# --- 임베딩 (KB 검색·근거 매칭) ---
# auto(OPENAI_API_KEY 있으면 openai, 없으면 hashing) | openai | hashing
# ⚠️ 프로바이더를 바꾸면 기존 청크 벡터와 비교할 수 없다. 문서를 다시 인제스트해야 한다.
EMBEDDING_PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==========================================================================
# 프런트엔드 / CORS
# ==========================================================================
# 브라우저가 직접 호출하는 API 주소다. **빌드 시점에 번들에 박히므로** 값을 바꾸면
# web 이미지를 다시 빌드해야 한다(deploy.sh 가 --build 로 처리한다).
#   - 리버스 프록시 뒤(권장):     https://certpilot-demo.example.com/api
#   - 공인 IP 로 바로(임시 데모):  http://<공인IP>:8000
NEXT_PUBLIC_API_URL=http://CHANGE_ME:8000

# API 가 CORS 로 허용할 브라우저 출처. 쉼표로 여러 개를 넣는다.
# 웹을 여는 주소와 **정확히** 같아야 한다(스킴·호스트·포트 모두).
#   - 리버스 프록시 뒤: https://certpilot-demo.example.com
#   - 공인 IP 로 바로:  http://<공인IP>:3000
WEB_ORIGINS=http://CHANGE_ME:3000

# 정규식으로 추가 허용(개발 편의 기능). 코드 기본값은 사설망(192.168.x.x 등)을
# 허용하지만, **운영·외부 공개 배포에서는 빈 값으로 꺼 두는 것을 권장한다.**
# 빈 값이면 위 WEB_ORIGINS 명시 목록만 쓴다.
WEB_ORIGIN_REGEX=

# ==========================================================================
# 세션 / 암호화
# ==========================================================================
# 생성: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME
# HTTPS 로 서비스하면 true. **평문 http(공인 IP 직접 접속)면 false 여야 로그인이 된다**
# — true 인데 http 면 브라우저가 세션 쿠키를 저장하지 않는다.
SESSION_COOKIE_SECURE=false

# 로그인 화면의 "데모 계정으로 둘러보기" 버튼 활성화.
# true 면 방문자가 비밀번호 없이 시드된 데모핀테크 org_member 계정으로 들어온다.
# 켜기 전에 `make demo` 로 데모 데이터를 시드해야 한다(안 되어 있으면 404).
# **공개 시연 서버에서만 true 를 권장한다** — 실제 고객 데이터가 있는 곳에서는 false.
DEMO_LOGIN_ENABLED=false

# 커넥터 자격증명 암호화 키 (Fernet, base64 32바이트)
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 키를 바꾸면 기존에 저장된 AWS 커넥터는 복호화되지 않아 다시 등록해야 한다.
CONNECTOR_ENCRYPTION_KEY=CHANGE_ME

# ==========================================================================
# 운영 파라미터
# ==========================================================================
# 이미지 태그. deploy.sh 가 이 값으로 빌드·기동하고, 롤백은 이 값을 되돌려 재실행한다.
IMAGE_TAG=latest
# Celery 워커 동시 실행 수. 2GB VM 이면 2, 오라클 Ampere(24GB)면 4 정도.
CELERY_CONCURRENCY=2

# api·web 컨테이너 포트를 호스트의 어느 주소에 붙일지.
# 기본 127.0.0.1 = 리버스 프록시만 접근 가능(권장).
# 프록시 없이 공인 IP 로 바로 열려면 0.0.0.0 으로 바꾸고, 클라우드 방화벽과 OS
# 방화벽에서 해당 포트를 연다. 이때 API 는 인터넷에 그대로 노출된다.
API_BIND=0.0.0.0
WEB_BIND=0.0.0.0

# 호스트에 게시할 포트. 컨테이너 안쪽은 항상 8000/3000 이라 이 값만 바꾸면 된다.
# 같은 서버에서 다른 서비스가 이미 8000·3000 을 쓰고 있으면 겹치지 않는 값으로
# 바꾼다(예: API_PORT=8010, WEB_PORT=3010). 리버스 프록시의 proxy_pass 주소와
# deploy.sh 헬스체크가 이 값을 따라간다.
API_PORT=8000
WEB_PORT=3000

# ==========================================================================
# 백업 (backup.sh)
# ==========================================================================
# pg_dump 결과를 보관할 로컬 디렉터리. 미리 만들고 소유권을 준다:
#   sudo mkdir -p /var/backups/certpilot && sudo chown "$USER" /var/backups/certpilot
BACKUP_DIR=/var/backups/certpilot
# 보존 기간(일). 이보다 오래된 백업은 backup.sh 가 지운다(로컬·S3 공통).
BACKUP_RETENTION_DAYS=30
# --- 아래는 옵션 --- 원격 사본을 S3 호환 스토리지에 둘 때만 채운다.
# 값이 비어 있으면 backup.sh 는 로컬 보관까지만 하고 정상 종료한다.
# 채우려면 호스트에 aws cli v2 가 설치돼 있어야 한다.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=postgres
# AWS 가 아닌 S3 호환 스토리지(오라클·MinIO)에 올릴 때만 지정한다.
# 예: https://<네임스페이스>.compat.objectstorage.ap-chuncheon-1.oraclecloud.com
BACKUP_S3_ENDPOINT=
