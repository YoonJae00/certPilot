# CertPilot 데모 배포 환경 변수 예시.
# 이 파일을 `.env.prod` 로 복사해서 값을 채운다. **`.env.prod` 는 절대 커밋하지 않는다**
# (리포 루트 .gitignore 가 `.env.*` 를 막고 있다).
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# 값은 EC2 인스턴스에 직접 두는 대신 AWS Systems Manager Parameter Store 나
# Secrets Manager 에서 내려받는 편이 낫다(README-deploy.md 참고).

# --- 데이터베이스 (RDS PostgreSQL 16, pgvector 확장 필요) ---
# RDS 를 쓰지 않고 compose 의 postgres 컨테이너를 켤 때는 호스트를 `postgres` 로 바꾼다.
DATABASE_URL=postgresql+psycopg://certpilot:CHANGE_ME@certpilot-db.xxxxxxxx.ap-northeast-2.rds.amazonaws.com:5432/certpilot

# --- Redis (Celery 브로커 겸 결과 백엔드) ---
# compose 안의 redis 컨테이너를 가리킨다. 컨테이너 이름이 곧 호스트명이다.
REDIS_URL=redis://redis:6379/0

# --- 오브젝트 스토리지 (실제 S3) ---
# 원문 문서·증적 스냅샷·산출물이 저장된다. 버킷은 퍼블릭 액세스 전면 차단 + 기본
# 암호화(SSE-S3 이상) + 버전 관리를 켠 상태로 만든다.
#
# ⚠️ 알려진 제약: apps/api/app/services/storage.py 가 리전을 us-east-1 로 고정한다.
#    지금은 버킷을 us-east-1 에 만들고 아래 엔드포인트를 그대로 쓴다.
#    서울 리전 버킷이 필요하면 S3_REGION 설정을 추가하는 작업이 선행돼야 한다.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_BUCKET=certpilot-demo-CHANGE_ME
# EC2 인스턴스 프로파일(IAM 역할)로 S3 에 접근하는 것이 원칙이지만, 현재 코드는
# 액세스 키를 직접 받는다. 데모용 전용 IAM 사용자를 만들고 이 버킷에만 권한을 준다.
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# --- LLM ---
# 비워 두면 결정적 Fake 프로바이더로 동작한다(판정 품질은 데모용이 아니다).
ANTHROPIC_API_KEY=

# --- 세션 쿠키 ---
# 생성: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME
# HTTPS 로 서비스하므로 반드시 true.
SESSION_COOKIE_SECURE=true

# --- 커넥터 자격증명 암호화 키 (Fernet, base64 32바이트) ---
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 키를 바꾸면 기존에 저장된 AWS 커넥터는 복호화되지 않아 다시 등록해야 한다.
CONNECTOR_ENCRYPTION_KEY=CHANGE_ME

# --- 프런트엔드 ---
# 브라우저가 직접 호출하는 주소다. **빌드 시점에 번들에 박히므로** 값을 바꾸면
# web 이미지를 다시 빌드해야 한다(deploy.sh 가 --build 로 처리한다).
NEXT_PUBLIC_API_URL=https://certpilot-demo.example.com/api

# API 가 CORS 로 허용할 브라우저 출처. 쉼표로 여러 개를 넣는다.
# 웹과 API 를 같은 도메인(리버스 프록시 /api)에 두면 이 값도 그 도메인 하나면 된다.
WEB_ORIGINS=https://certpilot-demo.example.com

# --- 운영 파라미터 ---
# 이미지 태그. deploy.sh 가 이 값으로 빌드·기동한다.
IMAGE_TAG=latest
# Celery 워커 동시 실행 수. t3.small 이면 2 정도가 적당하다.
CELERY_CONCURRENCY=2

# --- compose 의 local-db 프로파일을 쓸 때만 필요 ---
POSTGRES_USER=certpilot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=certpilot

# --- 백업 (backup.sh) ---
# pg_dump 결과를 올릴 버킷과 접두사.
BACKUP_S3_BUCKET=certpilot-demo-backup-CHANGE_ME
BACKUP_S3_PREFIX=postgres
# 보존 기간(일). 이보다 오래된 백업은 backup.sh 가 지운다.
BACKUP_RETENTION_DAYS=30
