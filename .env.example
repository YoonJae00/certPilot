# CertPilot 환경 변수 예시. 이 파일을 `.env` 로 복사해서 쓴다.
# 실제 비밀 값은 이 파일에 넣지 않는다.

# PostgreSQL 16 + pgvector (docker compose 기본값)
DATABASE_URL=postgresql+psycopg://certpilot:certpilot@localhost:5432/certpilot

# Redis (Celery 브로커 겸 캐시)
REDIS_URL=redis://localhost:6379/0

# 오브젝트 스토리지 — 로컬은 MinIO, 운영은 S3 호환 스토리지
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=certpilot
S3_SECRET_KEY=certpilot
S3_BUCKET=certpilot
# SigV4 서명 리전. MinIO 는 아무 값이나 통과, 실제 S3 호환 스토리지는 버킷 리전과 일치 필요.
S3_REGION=us-east-1

# LLM 프로바이더 선택: auto(키 있는 것 자동: openai → anthropic → fake) | openai | anthropic | fake
LLM_PROVIDER=auto
# OpenAI API 키 (기본 프로바이더 — 없으면 결정적 FakeProvider 로 동작)
OPENAI_API_KEY=
# 판정 모델 (2026-08 기준: gpt-5.6 균형 / gpt-5.6-luna 저가 / gpt-5.5 고성능)
OPENAI_MODEL=gpt-5.6
# Anthropic API 키 (옵션 대체 프로바이더)
ANTHROPIC_API_KEY=

# 임베딩: auto(OPENAI_API_KEY 있으면 openai, 없으면 hashing) | openai | hashing
# 프로바이더를 바꾸면 기존 청크와 비교 불가 — 문서 재인제스트(make demo) 필요.
EMBEDDING_PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# CORS: 명시 출처 목록(쉼표 구분) + 정규식(비우면 정규식 비활성).
# 기본 정규식은 사설망(192.168.x.x 등)을 허용해 같은 네트워크 다른 기기 접속을 지원한다.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_ORIGIN_REGEX=

# 세션 쿠키 서명 키. 로컬은 비워 두면 개발용 기본값을 쓰고, 배포에서는 반드시 채운다.
SESSION_SECRET=
# HTTPS 로 서비스할 때만 true (쿠키에 Secure 플래그를 붙인다)
SESSION_COOKIE_SECURE=false

# 커넥터 자격증명(AWS 역할 ARN·외부 ID·액세스 키) 암호화 키 — Fernet, base64 32바이트.
# 생성:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 비워 두면 SESSION_SECRET 에서 파생한 개발용 키를 쓰고 경고 로그를 남긴다.
# 운영에서는 반드시 KMS/시크릿 매니저의 값으로 채운다. 키를 바꾸면 기존 커넥터는
# 복호화되지 않으므로 다시 등록해야 한다.
CONNECTOR_ENCRYPTION_KEY=

# --- docker compose 호스트 포트 ---
# 다른 프로젝트가 같은 포트를 이미 쓰고 있을 때만 바꾼다.
# 바꾸면 위의 DATABASE_URL / REDIS_URL / S3_ENDPOINT 포트도 같이 맞춰야 한다.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
